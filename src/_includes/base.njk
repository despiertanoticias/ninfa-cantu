<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set tituloPagina = (title + " | " + sitio.titulo) if title else (sitio.titulo + " | Sitio oficial") %}
  {% set descPagina = resumen or descripcion or sitio.descripcion %}
  {% set imgPagina = imagen or "/assets/img/og.jpg" %}
  <title>{{ tituloPagina }}</title>
  <meta name="description" content="{{ descPagina }}">
  <link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
  <meta property="og:type" content="{{ 'article' if layout == 'noticia.njk' else 'website' }}">
  <meta property="og:site_name" content="{{ sitio.titulo }}">
  <meta property="og:title" content="{{ title or sitio.titulo }}">
  <meta property="og:description" content="{{ descPagina }}">
  <meta property="og:image" content="{{ sitio.url }}{{ imgPagina }}">
  <meta property="og:url" content="{{ sitio.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#5E0B1E">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/estilos.css">
</head>
<body class="{{ claseBody }}">
  <a class="saltar" href="#contenido">Ir al contenido</a>

  <header class="cabecera">
    <div class="cabecera__in">
      <a class="cabecera__logo" href="/" aria-label="Inicio, {{ perfil.nombre }}">
        <img src="/assets/img/logo-ninfa-cantu-sm.png" alt="Ninfa Cantú" width="666" height="131">
      </a>
      <button class="menu-btn" aria-expanded="false" aria-controls="menu" type="button">
        <span class="menu-btn__barras" aria-hidden="true"></span>
        <span class="menu-btn__txt">Menú</span>
      </button>
      <nav id="menu" class="menu" aria-label="Principal">
        {% set enlaces = [["/", "Inicio"], ["/biografia/", "Biografía"], ["/trayectoria/", "Trayectoria"], ["/noticias/", "Noticias"], ["/contacto/", "Contacto"]] %}
        <ul>
        {% for e in enlaces %}
          <li><a href="{{ e[0] }}" {% if page.url | activo(e[0]) %}aria-current="page"{% endif %}>{{ e[1] }}</a></li>
        {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenido">
    {{ content | safe }}
  </main>

  <footer class="pie">
    <div class="pie__in">
      <div class="pie__marca">
        <img src="/assets/img/logo-ninfa-cantu-sm.png" alt="Ninfa Cantú" width="666" height="131" loading="lazy">
        <p>{{ perfil.lema }}</p>
      </div>
      <nav class="pie__nav" aria-label="Pie de página">
        <a href="/biografia/">Biografía</a>
        <a href="/trayectoria/">Trayectoria</a>
        <a href="/noticias/">Noticias</a>
        <a href="/contacto/">Contacto</a>
      </nav>
      {% include "redes.njk" %}
    </div>
    <div class="pie__legal">
      <p>© {{ "" | anio }} {{ perfil.nombre }}. Todos los derechos reservados.</p>
      {% if perfil.correo %}<a href="mailto:{{ perfil.correo }}">{{ perfil.correo }}</a>{% endif %}
    </div>
  </footer>

  <script>
    (function () {
      var b = document.querySelector('.menu-btn'), m = document.getElementById('menu');
      if (!b) return;
      b.addEventListener('click', function () {
        var abierto = b.getAttribute('aria-expanded') === 'true';
        b.setAttribute('aria-expanded', String(!abierto));
        m.classList.toggle('menu--abierto', !abierto);
      });
    })();
  </script>
  {% if page.url == "/" %}
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      netlifyIdentity.on("init", function (u) {
        if (!u) netlifyIdentity.on("login", function () { document.location.href = "/admin/"; });
      });
    }
  </script>
  {% endif %}
</body>
</html>
