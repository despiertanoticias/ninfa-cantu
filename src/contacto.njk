---
layout: base.njk
title: Contacto
descripcion: Envía un mensaje, invitación o solicitud a Ninfa Cantú de Andar.
permalink: /contacto/
---
<header class="encabezado">
  <div class="contenedor">
    <h1>Contacto</h1>
    <p>Mensajes, invitaciones a eventos y solicitudes de entrevista.</p>
  </div>
</header>

<section class="bloque">
  <div class="contenedor contacto">
    <form class="formulario" name="contacto" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="sitio-web">
      <input type="hidden" name="form-name" value="contacto">
      <p class="oculto"><label>No llenar: <input name="sitio-web"></label></p>
      <div class="campo"><label for="f-nombre">Nombre completo</label><input id="f-nombre" name="nombre" autocomplete="name" required></div>
      <div class="campo-doble">
        <div class="campo"><label for="f-correo">Correo electrónico</label><input id="f-correo" type="email" name="correo" autocomplete="email" required></div>
        <div class="campo"><label for="f-tel">Teléfono <span>(opcional)</span></label><input id="f-tel" type="tel" name="telefono" autocomplete="tel"></div>
      </div>
      <div class="campo"><label for="f-motivo">Motivo</label>
        <select id="f-motivo" name="motivo">
          <option>Mensaje general</option>
          <option>Invitación a un evento</option>
          <option>Solicitud de entrevista</option>
          <option>Gestión o solicitud ciudadana</option>
        </select>
      </div>
      <div class="campo"><label for="f-msj">Mensaje</label><textarea id="f-msj" name="mensaje" rows="6" required></textarea></div>
      <button class="btn btn--guinda" type="submit">Enviar mensaje</button>
    </form>
    <aside class="contacto__datos">
      {% if perfil.correo %}<div><h2>Correo</h2><a href="mailto:{{ perfil.correo }}">{{ perfil.correo }}</a></div>{% endif %}
      {% if perfil.telefono %}<div><h2>Teléfono</h2><a href="tel:{{ perfil.telefono | replace(' ', '') }}">{{ perfil.telefono }}</a></div>{% endif %}
      {% set r = perfil.redes %}
      {% if r.facebook or r.instagram or r.x or r.youtube or r.tiktok %}<div><h2>Redes sociales</h2>{% include "redes.njk" %}</div>{% endif %}
    </aside>
  </div>
</section>
