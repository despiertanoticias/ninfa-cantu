---
layout: base.njk
title: Noticias
descripcion: Noticias, agenda y comunicados de Ninfa Cantú de Andar.
pagination:
  data: collections.noticias
  size: 9
  alias: lista
permalink: "/noticias/{% if pagination.pageNumber > 0 %}pagina/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<header class="encabezado">
  <div class="contenedor">
    <h1>Noticias</h1>
    <p>Actividades, agenda y comunicados.</p>
  </div>
</header>

<section class="bloque">
  <div class="contenedor">
    {% if lista | length %}
    <div class="rejilla">
      {% for n in lista %}{% set mostrarResumen = true %}{% include "tarjeta.njk" %}{% endfor %}
    </div>
    {% if pagination.pages | length > 1 %}
    <nav class="paginacion" aria-label="Páginas de noticias">
      {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">Más recientes</a>{% else %}<span></span>{% endif %}
      <span>Página {{ pagination.pageNumber + 1 }} de {{ pagination.pages | length }}</span>
      {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Anteriores</a>{% else %}<span></span>{% endif %}
    </nav>
    {% endif %}
    {% else %}
    <p class="vacio">Todavía no hay noticias publicadas.</p>
    {% endif %}
  </div>
</section>
