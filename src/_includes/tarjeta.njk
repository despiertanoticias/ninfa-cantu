<article class="tarjeta">
  <a class="tarjeta__img" href="{{ n.url }}" tabindex="-1" aria-hidden="true">
    <img src="{{ n.data.imagen or '/assets/img/og.jpg' }}" alt="" loading="lazy" width="1200" height="750">
  </a>
  <div class="tarjeta__txt">
    <p class="meta"><span class="meta__cat">{{ n.data.categoria }}</span> <time datetime="{{ n.date | iso }}">{{ n.date | fechaCorta }}</time></p>
    <h3 class="tarjeta__titulo"><a href="{{ n.url }}">{{ n.data.title }}</a></h3>
    {% if mostrarResumen %}<p class="tarjeta__resumen">{{ n.data.resumen }}</p>{% endif %}
  </div>
</article>
